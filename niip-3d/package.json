{
  "name": "niip-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NIIP - National ICT Intelligence Program: interactive 3D model + cinematic renderer (9:16 or 16:9)",
  "scripts": {
    "serve": "node serve.mjs 4400",
    "render": "node render/render.mjs",
    "render:preview": "node render/render.mjs --scale 0.5 --out out/niip-preview.mp4",
    "stills": "node render/render.mjs --stills 2,9.8,13.8,19,23,26,29,31,35,39,41.5,43.5,45.5,47.5,49.5,52,57",
    "render:landscape": "node render/render.mjs --w 1920 --h 1080 --out out/niip-1920x1080.mp4"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "puppeteer-core": "^23.11.1"
  }
}
